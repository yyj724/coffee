<%- include('partials/header') %>
<div class="container auth-wrap">
  <div class="row justify-content-center w-100">
    <div class="col-md-6 col-lg-4">
      <div class="form-card p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="display-6">☕</div>
          <h3 class="fw-bold mt-2">로그인</h3>
        </div>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post" action="/login">
          <div class="mb-3"><label class="form-label">아이디</label>
            <input class="form-control form-control-lg" name="username" required autofocus></div>
          <div class="mb-4"><label class="form-label">비밀번호</label>
            <input type="password" class="form-control form-control-lg" name="password" required></div>
          <button class="btn btn-caramel btn-lg w-100">로그인</button>
        </form>
        <div class="text-center mt-3 small text-muted">계정이 없나요? <a href="/register">회원가입</a></div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
