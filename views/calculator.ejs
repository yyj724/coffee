<%- include('partials/header') %>
<% const v = (k, d) => (form[k] ?? (d === undefined ? '' : d));
   const stateIcon = { ok: 'bi-check-circle-fill text-success', below: 'bi-arrow-down-circle-fill text-warning', above: 'bi-arrow-up-circle-fill text-danger' }; %>
<div class="container py-5">
  <div class="text-center mb-4">
    <h2 class="section-title">추출 계산기</h2>
    <p class="section-sub">저장하지 않고 바로 비율·수율을 계산하고 추출 상태를 진단해 보세요.</p>
  </div>
  <div class="row g-4">
    <div class="col-lg-6">
      <form id="calc" class="form-card p-4" method="post" action="/calculator">
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <div class="mb-3"><label class="form-label">추출 방식</label>
          <select class="form-select" name="method_id" required><option value="">선택</option>
            <% methods.forEach(function(m) { %><option value="<%= m.id %>" <%= String(v('method_id')) === String(m.id) ? 'selected' : '' %>><%= m.name %></option><% }); %>
          </select></div>
        <div class="row g-3 mb-3">
          <div class="col-4"><label class="form-label">원두 (g)</label>
            <input type="number" step="0.1" min="0.1" class="form-control" name="dose_g" value="<%= v('dose_g') %>" required></div>
          <div class="col-4"><label class="form-label">물 (g)</label>
            <input type="number" step="0.1" min="1" class="form-control" name="water_g" value="<%= v('water_g') %>" required></div>
          <div class="col-4"><label class="form-label">물 온도 (°C)</label>
            <input type="number" min="0" max="100" class="form-control" name="water_temp_c" value="<%= v('water_temp_c') %>"></div>
        </div>
        <div class="mb-3"><label class="form-label">추출 시간</label>
          <div class="input-group">
            <input type="number" min="0" class="form-control" name="brew_min" value="<%= v('brew_min', 2) %>"><span class="input-group-text">분</span>
            <input type="number" min="0" max="59" class="form-control" name="brew_sec" value="<%= v('brew_sec', 30) %>"><span class="input-group-text">초</span>
          </div></div>
        <div class="row g-3 mb-3">
          <div class="col-6"><label class="form-label">TDS (%) <span class="text-muted small">선택</span></label>
            <input type="number" step="0.01" min="0" class="form-control" name="tds_pct" value="<%= v('tds_pct') %>"></div>
          <div class="col-6"><label class="form-label">추출액 (g) <span class="text-muted small">선택</span></label>
            <input type="number" step="0.1" min="0" class="form-control" name="output_g" value="<%= v('output_g') %>"></div>
        </div>
        <div class="mb-2"><label class="form-label d-flex justify-content-between"><span>산미</span><output id="o_sour"><%= v('sour', 3) %></output></label>
          <input type="range" class="form-range" min="1" max="5" name="sour" value="<%= v('sour', 3) %>" oninput="document.getElementById('o_sour').textContent=this.value"></div>
        <div class="mb-3"><label class="form-label d-flex justify-content-between"><span>쓴맛</span><output id="o_bitter"><%= v('bitter', 3) %></output></label>
          <input type="range" class="form-range" min="1" max="5" name="bitter" value="<%= v('bitter', 3) %>" oninput="document.getElementById('o_bitter').textContent=this.value"></div>

        <div class="row g-2 mb-3 text-center">
          <div class="col-6"><div class="metric"><div class="v" id="live_ratio">-</div><div class="k">추출 비율 (실시간)</div></div></div>
          <div class="col-6"><div class="metric"><div class="v" id="live_ey">-</div><div class="k">추출 수율 (실시간)</div></div></div>
        </div>
        <button class="btn btn-caramel btn-lg w-100"><i class="bi bi-activity me-2"></i>진단하기</button>
      </form>
    </div>

    <div class="col-lg-6">
      <% if (!result) { %>
        <div class="form-card p-5 text-center h-100 d-flex flex-column justify-content-center">
          <div class="display-4 mb-2">🧪</div>
          <p class="text-muted mb-0">값을 입력하고 <strong>진단하기</strong>를 누르면<br>추출 상태와 개선 방법이 여기에 나와요.</p>
        </div>
      <% } else { %>
        <div class="diag-card bg-white">
          <div class="diag-head <%= result.status %>">
            <div class="small opacity-75">추출 진단</div>
            <div class="fs-4 fw-bold"><i class="bi <%= result.icon %> me-2"></i><%= result.label %></div>
          </div>
          <div class="p-4">
            <div class="row g-2 mb-3 text-center">
              <div class="col-6"><div class="metric"><div class="v">1:<%= result.ratio %></div><div class="k">추출 비율</div></div></div>
              <div class="col-6"><div class="metric"><div class="v"><%= result.ey !== null ? result.ey + '%' : '-' %></div><div class="k">추출 수율</div></div></div>
            </div>
            <% if (result.reasons.length) { %>
              <div class="fw-bold small text-muted mb-1">근거</div>
              <ul class="mb-3 ps-3"><% result.reasons.forEach(function(r) { %><li><%= r %></li><% }); %></ul>
            <% } %>
            <div class="fw-bold small text-muted mb-1">이렇게 해 보세요</div>
            <ul class="mb-3 ps-3"><% result.tips.forEach(function(t) { %><li><%= t %></li><% }); %></ul>
            <div class="fw-bold small text-muted mb-1">기준 점검</div>
            <% result.checks.forEach(function(c) { %>
              <div class="check-row"><span><i class="bi <%= stateIcon[c.state] %> me-1"></i><%= c.label %></span>
                <span><strong><%= c.value %></strong> <span class="text-muted small">(<%= c.range %>)</span></span></div>
            <% }); %>
            <div class="small text-muted mt-3 mb-3">※ 맛은 주관적이라 이 진단은 일반적으로 알려진 기준을 바탕으로 한 참고용 가이드예요.</div>
            <% if (user) { %>
              <a class="btn btn-outline-roast w-100" href="/recipes/new?<%= prefillQuery %>"><i class="bi bi-journal-plus me-1"></i>이 값으로 레시피 쓰기</a>
            <% } else { %>
              <a class="btn btn-outline-roast w-100" href="/login">로그인하고 레시피로 저장하기</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<script>
(function () {
  var f = document.getElementById('calc');
  function upd() {
    var dose = parseFloat(f.dose_g.value), water = parseFloat(f.water_g.value);
    var tds = parseFloat(f.tds_pct.value), out = parseFloat(f.output_g.value);
    document.getElementById('live_ratio').textContent = dose > 0 && water > 0 ? '1:' + (water / dose).toFixed(1) : '-';
    document.getElementById('live_ey').textContent = dose > 0 && tds > 0 && out > 0 ? (tds * out / dose).toFixed(1) + '%' : '-';
  }
  ['dose_g', 'water_g', 'tds_pct', 'output_g'].forEach(function (n) { f[n].addEventListener('input', upd); });
  upd();
})();
</script>
<%- include('partials/footer') %>
